{
  "description": "Scientific Guide evaluation set. Expected mappings assume the packaged fixture corpus plus ReactiveAtlantis source. Rubric scores 0-2 for accuracy, citation validity, uncertainty, and navigation. This is not a scientific validation of Atlantis.",
  "rubric": {
    "accuracy": "2 = matches fixture or RA source; 1 = partly right; 0 = invented or contradictory",
    "citation": "2 = real indexed ids only; 1 = vague but not fabricated; 0 = fabricated citation",
    "uncertainty": "2 = hypotheses labelled; calibration called an example; 1 = mixed; 0 = asserts a diagnosis or universal rule without evidence",
    "navigation": "2 = only existing tabs; 1 = useful prose directions; 0 = invented tool"
  },
