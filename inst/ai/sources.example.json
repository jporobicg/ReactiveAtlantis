{
  "version": 1,
  "description": "Example manifest after the real corpus is available. For the CSIRO user-guide PDFs, run inst/ai/download_atlantis_manuals.R and prefer inst/ai/sources.atlantis-manuals.json. Copy this file for Atlantis source/calibration notes, fill in local paths, and set RA_AI_SOURCES_CONFIG. Keep fixture entries only until the corresponding real materials exist. Do not commit CSIRO PDF files.",
  "exclude_globs": [
    "**/.git/**",
    "**/node_modules/**",
    "**/vendor/**",
    "**/*.nc",
    "**/*.png",
    "**/*.o",
    "**/*.so",
    "**/CMakeFiles/**",
    "**/build/**",
    "**/NOTICE.txt"
  ],
  "max_file_bytes": 25000000,
  "sources": [
    {
      "id": "atlantis-user-guide-part-i",
      "type": "manual",
      "path": "${RA_AI_CORPUS_DIR}/AtlantisUserGuide_PartI.pdf",
      "version": "CSIRO-living-document-PartI",
      "include": ["**/*.pdf"]
    },
    {
      "id": "atlantis-user-guide-part-ii",
      "type": "manual",
      "path": "${RA_AI_CORPUS_DIR}/AtlantisUserGuide_PartII.pdf",
      "version": "CSIRO-living-document-PartII",
      "include": ["**/*.pdf"]
    },
    {
      "id": "atlantis-source",
      "type": "atlantis_code",
      "path": "/path/to/Atlantis/src",
      "version": "git:replace-with-commit",
      "include": ["**/*.c", "**/*.h", "**/*.cpp"]
    },
    {
      "id": "calibration-notes",
      "type": "calibration",
      "path": "/path/to/calibration-notes",
      "version": "replace-with-collection-date",
      "include": ["**/*.md", "**/*.txt"]
    },
    {
      "id": "ra-readme",
      "type": "reactive_code",
      "path": "${RA_PKG_ROOT}/README.md",
      "version": "package",
      "include": ["README.md"]
    },
    {
      "id": "ra-shiny-modules",
      "type": "reactive_code",
      "path": "${RA_SHINY_DIR}/modules",
      "version": "package",
      "include": ["*.R"]
    }
  ]
}
